rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProject() {
      return request.resource.data.keys().hasAll([
          'title', 'subjectAreaId', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'subjectAreaId', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.subjectAreaId is string
        && request.resource.data.subjectAreaId.size() > 0
        && request.resource.data.subjectAreaId.size() <= 120
        && request.resource.data.status == 'draft'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt == request.resource.data.updatedAt;
    }

    match /users/{userId}/projects/{projectId} {
      allow get, list: if signedInAs(userId);
      allow create: if signedInAs(userId) && validProject();
      allow update, delete: if false;
    }
  }
}
